index 0000000000000000000000000000000000000000..b10fb5ea68d6374a2cc5889f94b0ec6658883b0e
--- /dev/null
+++ b/.github/workflows/auto-tag.yml
@@ -0,0 +1,197 @@
+# Auto-tag: create v<version> when the version in Cargo.toml changes on main
+# Ported from ashlrai/phantom-secrets auto-tag.yml (RQ-AUTOTAGPORTLOCUSQ8).
+# and every required check plus manual full-suite CI for that exact commit is green.
+# Tags are created only here, with the ashlr-release GitHub App token, so the
+# tag-triggered release workflow runs. release-please (if present) only opens
+# version PRs and never creates tags.
+#
+# Required checks are discovered at run time from the branch rules API
+# (rulesets) unioned with classic branch protection contexts. Fail closed:
+# - no required checks discovered: fail
+# - only GitHub Actions check runs (app id 15368) count; every latest run with
+#   a required name must be completed + success; commit statuses never count
+# - a required check missing, queued or in progress: bounded wait (~9.5 min),
+#   then no tag (notice on the push trigger, which workflow_run re-evaluates;
+#   failure on workflow_run)
+# - any conclusion other than success: fail at once. skipped and neutral are NOT
+#   green: required checks here use the skip-job pattern (phantom #811),
+#   which reports success, so a skipped required check means it did not run.
+name: Auto-tag
+
+on:
+  push:
+    branches: [main]
+    paths: ["Cargo.toml"]
+  workflow_run:
+    workflows: ["CI"]
+    types: [completed]
+    branches: [main]
+  # Manual path (one command): gh workflow run auto-tag.yml -R <owner>/<repo>
+  # Tags the current main manifest version if that tag is absent and every
+  # required check on the main head is green. Same gate as the automatic path.
+  workflow_dispatch:
+
+permissions: {}
+
+concurrency:
+  group: auto-tag-${{ github.repository }}
+  cancel-in-progress: false
+
+jobs:
+  tag:
+    if: github.event_name == 'push' || (github.event.workflow_run.conclusion == 'success' && github.event.workflow_run.event == 'workflow_dispatch' && github.event.workflow_run.head_branch == 'main' && github.event.workflow_run.head_repository.full_name == github.repository) || (github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main')
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    permissions:
+      contents: read
+      checks: read     # read check-runs for the exact commit
+      actions: write   # dispatch release.yml if the tag push did not start it
+    env:
+      GH_TOKEN: ${{ github.token }}
+      REPO: ${{ github.repository }}
+      BRANCH: main
+      VERSION_FILE: Cargo.toml
+      SHA: ${{ github.event_name == 'workflow_run' && github.event.workflow_run.head_sha || github.sha }}
+      TRIGGER: ${{ github.event_name }}
+      ACTIONS_APP_ID: "15368"   # GitHub Actions; other apps' same-named runs never count
+    steps:
+      - name: Detect version change
+        id: version
+        shell: bash
+        run: |
+          set -euo pipefail
+          read_version() {
+            gh api -H 'Accept: application/vnd.github.raw' "repos/$REPO/contents/$VERSION_FILE?ref=$1" | python3 -c 'import sys,tomllib; d=tomllib.loads(sys.stdin.read()); print((d.get("workspace",{}).get("package") or d["package"])["version"])'
+          }
+          [[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "::error::invalid candidate sha"; exit 1; }
+          main=$(gh api "repos/$REPO/commits/$BRANCH" -q '.sha')
+          [ "$main" = "$SHA" ] || { echo "::error::main moved; qualify its exact current sha"; exit 1; }
+          parent=$(gh api "repos/$REPO/commits/$SHA" -q '.parents[0].sha')
+          new=$(read_version "$SHA")
+          old=$(read_version "$parent")
+          [[ "$new" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "::error::unexpected version '$new'"; exit 1; }
+          if [ "$new" = "$old" ] && [ "$TRIGGER" != workflow_dispatch ]; then
+            echo "Version unchanged ($new); nothing to tag."
+            echo "changed=false" >> "$GITHUB_OUTPUT"; exit 0
+          fi
+          if git ls-remote --exit-code --tags "https://github.com/$REPO.git" "refs/tags/v$new" >/dev/null; then
+            echo "Tag v$new already exists; nothing to do."
+            echo "changed=false" >> "$GITHUB_OUTPUT"; exit 0
+          else
+            status=$?
+            [ "$status" -eq 2 ] || { echo "::error::tag lookup failed; refusing to assume absence"; exit 1; }
+          fi
+          echo "version=$new" >> "$GITHUB_OUTPUT"
+          echo "changed=true" >> "$GITHUB_OUTPUT"
+
+      - name: Require every required check green on this exact commit
+        id: checks
+        if: steps.version.outputs.changed == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          # Separate assignments propagate errors from either API. A successful
+          # second query must never hide a failed ruleset read.
+          rules=$(gh api "repos/$REPO/rules/branches/$BRANCH" -q '.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[].context')
+          classic=$(gh api "repos/$REPO/branches/$BRANCH" -q '.protection.required_status_checks.contexts[]?')
+          required=$(printf '%s\n%s\n' "$rules" "$classic" | sed '/^$/d' | sort -u)
+          if [ -z "$required" ]; then
+            echo "::error::no required checks discovered for $BRANCH; refusing to tag"; exit 1
+          fi
+          # One evaluation pass. Check runs: only GitHub Actions (app id
+          # $ACTIONS_APP_ID) counts, and EVERY latest run with the required name
+          # must be completed + success. Commit statuses are ignored: a required
+          # name with no app-15368 check run is missing.
+          evaluate() {
+            runs=$(gh api --paginate "repos/$REPO/commits/$SHA/check-runs?filter=latest&app_id=$ACTIONS_APP_ID&per_page=100"               -q '.check_runs[] | select(.app.id == '"$ACTIONS_APP_ID"') | [.name, .status, (.conclusion // "")] | @tsv')
+            pending=0; bad=0
+            while IFS= read -r name; do
+              rows=$(awk -F'	' -v n="$name" '$1==n' <<<"$runs")
+              if [ -n "$rows" ]; then
+                while IFS=$'	' read -r _ status conclusion; do
+                  if [ "$status" != completed ]; then echo "pending: $name ($status)"; pending=1
+                  elif [ "$conclusion" = success ]; then echo "green: $name"
+                  else echo "::error::not green: $name ($conclusion)"; bad=1; fi
+                done <<<"$rows"
+                continue
+              fi
+              echo "missing: $name (no GitHub Actions check run; commit statuses never satisfy a required check)"; pending=1
+            done <<<"$required"
+          }
+          # Bounded wait while checks are pending or not yet reported:
+          # about 9.5 minutes total, then decide. Failures stop at once.
+          for delay in 0 20 40 60 90 120 120 120; do
+            sleep "$delay"
+            evaluate
+            if [ "$bad" = 1 ]; then exit 1; fi
+            if [ "$pending" = 0 ]; then echo "green=true" >> "$GITHUB_OUTPUT"; exit 0; fi
+          done
+          if [ "$TRIGGER" = push ]; then
+            echo "::notice::required checks still not finished; the workflow_run trigger re-evaluates after CI"
+            echo "green=false" >> "$GITHUB_OUTPUT"; exit 0
+          fi
+          echo "::error::required checks missing or pending after CI completed and a bounded wait; refusing to tag"; exit 1
+
+      - name: Require a successful workflow_dispatch full suite on this exact commit
+        id: evidence
+        if: steps.checks.outputs.green == 'true'
+        shell: bash
+        run: |
+          set -euo pipefail
+          n=$(gh api "repos/$REPO/actions/workflows/ci.yml/runs?event=workflow_dispatch&head_sha=$SHA&status=success&per_page=100" --jq '[.workflow_runs[] | select(.event == "workflow_dispatch" and .status == "completed" and .conclusion == "success" and .head_sha == "'"$SHA"'")] | length')
+          if ! [[ "$n" =~ ^[0-9]+$ ]] || [ "$n" -lt 1 ]; then
+            echo "::error::No successful manual full-suite CI on $SHA; host must qualify this exact main commit before tagging."
+            exit 1
+          fi
+          echo "qualified=true" >> "$GITHUB_OUTPUT"
+
+      - name: Mint ashlr-release App token (contents write, this repo only)
+        id: app
+        if: steps.evidence.outputs.qualified == 'true'
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
+        with:
+          app-id: ${{ vars.ASHLR_RELEASE_APP_ID }}
+          private-key: ${{ secrets.ASHLR_RELEASE_APP_KEY }}
+          owner: ${{ github.repository_owner }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+
+      - name: Create tag v${{ steps.version.outputs.version }}
+        if: steps.evidence.outputs.qualified == 'true'
+        shell: bash
+        env:
+          GH_TOKEN: ${{ steps.app.outputs.token }}
+          VERSION: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          main=$(gh api "repos/$REPO/commits/$BRANCH" -q '.sha')
+          [ "$main" = "$SHA" ] || { echo "::error::main moved after qualification; refusing to tag"; exit 1; }
+          if refs=$(git ls-remote --exit-code --tags "https://github.com/$REPO.git" "refs/tags/v$VERSION" "refs/tags/v$VERSION^{}"); then
+            tagged=$(printf '%s\n' "$refs" | tail -1 | cut -f1)
+            [ "$tagged" = "$SHA" ] || { echo "::error::tag appeared at another commit; refusing release dispatch"; exit 1; }
+            echo "Tag v$VERSION appeared meanwhile; nothing to do."; exit 0
+          else
+            status=$?
+            [ "$status" -eq 2 ] || { echo "::error::tag lookup failed; refusing to assume absence"; exit 1; }
+          fi
+          gh api -X POST "repos/$REPO/git/refs" -f ref="refs/tags/v$VERSION" -f sha="$SHA" >/dev/null
+          echo "Created v$VERSION at $SHA" >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Make sure release.yml runs for v${{ steps.version.outputs.version }}
+        if: steps.evidence.outputs.qualified == 'true'
+        shell: bash
+        env:
+          VERSION: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          # An App-token tag push starts release.yml. If no run for the tag
+          # appears within about 2 minutes, dispatch it once with GITHUB_TOKEN
+          # (workflow_dispatch is the documented exception that GITHUB_TOKEN
+          # may trigger). No PAT, no manual step.
+          for delay in 15 15 30 30 30; do
+            sleep "$delay"
+            n=$(gh api "repos/$REPO/actions/workflows/release.yml/runs?branch=v$VERSION&per_page=5" -q '.total_count')
+            if [ "${n:-0}" -ge 1 ]; then echo "release.yml started for v$VERSION" >> "$GITHUB_STEP_SUMMARY"; exit 0; fi
+          done
+          gh workflow run release.yml -R "$REPO" --ref "$BRANCH" -f version="$VERSION"
+          echo "Dispatched release.yml for v$VERSION" >> "$GITHUB_STEP_SUMMARY"
