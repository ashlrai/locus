@@ -0,0 +1,53 @@
+name: Windows install smoke
+
+# Not part of the default CI matrix. Runs on a release tag, on manual
+# dispatch, and on a pull request only when installer, wrapper, or OS
+# setup paths change.
+on:
+  pull_request:
+    paths:
+      - "npm/**"
+      - "npm-mcp/**"
+      - "scripts/install.sh"
+      - "scripts/install.ps1"
+      - "scripts/setup.mjs"
+      - "scripts/setup.ps1"
+      - "scripts/setup.sh"
+      - ".github/workflows/release.yml"
+      - ".github/workflows/windows-install-smoke.yml"
+  push:
+    tags:
+      - "v*"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  smoke:
+    name: install smoke (windows)
+    runs-on: windows-latest
+    timeout-minutes: 30
+    steps:
+      - name: Checkout
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false
+
+      - name: Install Rust toolchain
+        uses: dtolnay/rust-toolchain@b725eda525362e7cf34af9a7243cac1e3f01a7ec # stable
+
+      - name: Build the Windows binaries
+        run: cargo build --release --locked -p locus-cli -p locus-mcp
+
+      - name: Smoke the Windows binaries
+        shell: pwsh
+        run: |
+          ./target/release/locus.exe --version
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          ./target/release/locus-mcp.exe --version
+          exit $LASTEXITCODE
+
+      - name: Wrapper names the Windows zip and exe
+        shell: pwsh
+        run: node --test npm/test/win32-paths.test.js npm/test/wrappers.test.js
